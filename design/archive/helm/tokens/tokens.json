{
  "$name": "bro / Helm design tokens",
  "$rules": "See ../DESIGN.md. Domain colours mark data only; accent marks interaction only; alert is risk only, max once per screen. Dark is default.",
  "color": {
    "dark": {
      "base": "#0B0F14", "surface1": "#121820", "surface2": "#1A222C", "surface3": "#232D39",
      "hairline": "rgba(255,255,255,0.08)", "hairlineStrong": "rgba(255,255,255,0.14)",
      "ink": "#E8ECF0", "ink2": "#9AA6B2", "ink3": "#5F6B77",
      "mind": "#7FB3D5", "body": "#8FBF8A", "sleep": "#A99BE0", "load": "#E0B45A", "alert": "#E07A6A",
      "glass": "rgba(26,34,44,0.74)"
    },
    "light": {
      "base": "#EEF1F4", "surface1": "#F7F8FA", "surface2": "#FFFFFF", "surface3": "#E3E8ED",
      "hairline": "rgba(10,20,30,0.08)", "hairlineStrong": "rgba(10,20,30,0.14)",
      "ink": "#12181F", "ink2": "#4F5B67", "ink3": "#8B96A1",
      "mind": "#3F7CA3", "body": "#4E8B55", "sleep": "#6E5FB8", "load": "#A8791E", "alert": "#B8483B",
      "glass": "rgba(255,255,255,0.74)"
    },
    "domainMap": {
      "$note": "A measurement's domain never changes per screen.",
      "mind": ["mood", "stress", "energy", "productivity", "check-ins", "life wheel"],
      "body": ["weight", "body fat", "resting heart rate", "steps", "tape sites", "energy intake"],
      "sleep": ["sleep duration", "sleep timing"],
      "load": ["training load", "alcohol", "caffeine", "cigarettes", "nicotine"],
      "alert": ["genuine health risk only"]
    },
    "accent": {
      "$usage": "User-owned hue 0-360 stored as accentHue. Interaction surfaces only. Derived in OKLCH; never store a hex.",
      "model": "oklch",
      "chroma": 0.12,
      "derive": {
        "dark":  { "accent": { "L": 0.74, "Cx": 1.0 }, "accentDeep": { "L": 0.36, "Cx": 0.7 }, "onAccent": { "L": 0.16, "C": 0.04 } },
        "light": { "accent": { "L": 0.50, "Cx": 1.0 }, "accentDeep": { "L": 0.90, "Cx": 0.45 }, "onAccent": { "L": 0.98, "C": 0.02 } }
      },
      "presets": [
        { "name": "Ice", "hue": 212, "default": true },
        { "name": "Lichen", "hue": 140 },
        { "name": "Amber", "hue": 80 },
        { "name": "Ember", "hue": 35 },
        { "name": "Violet", "hue": 300 },
        { "name": "Teal", "hue": 190 }
      ]
    }
  },
  "type": {
    "family": {
      "sans":  { "name": "Instrument Sans", "fallback": "system sans", "role": "all interface text" },
      "mono":  { "name": "Geist Mono", "fallback": "JetBrains Mono / SF Mono / Roboto Mono", "role": "every readout and data number, tabular" },
      "serif": { "name": "Instrument Serif", "fallback": "system serif", "role": "the user's own words only" }
    },
    "scale": {
      "largeTitle": { "px": 32, "weight": 700, "tracking": "-0.03em" },
      "title":      { "px": 26, "weight": 600, "tracking": "-0.02em" },
      "section":    { "px": 19, "weight": 600 },
      "body":       { "px": 15, "weight": 400, "lineHeight": 1.5 },
      "caption":    { "px": 12.5, "weight": 400 },
      "footnote":   { "px": 12, "weight": 400 },
      "monoHero":   { "px": 56, "weight": 600, "tracking": "-0.05em", "family": "mono" },
      "monoDial":   { "px": 44, "weight": 600, "tracking": "-0.04em", "family": "mono" },
      "monoReadout":{ "px": 30, "weight": 600, "tracking": "-0.03em", "family": "mono" },
      "monoList":   { "px": 18, "weight": 600, "family": "mono" },
      "monoInline": { "px": 13, "weight": 500, "family": "mono" },
      "serifQuote": { "px": 21, "weight": 400, "family": "serif", "lineHeight": 1.25 }
    },
    "case": "sentence case everywhere"
  },
  "space": { "unit": 4, "scale": [4, 8, 12, 16, 24, 32, 48, 64], "gutter": 16 },
  "radius": { "chip": 6, "control": 12, "card": 20, "sheet": 28, "device": 44 },
  "elevation": { "steps": ["base", "surface1", "surface2", "surface3"], "method": "luminance", "glass": { "opacity": 0.74, "blur": 20 }, "cardShadow": "none", "sheetShadow": "0 -20 60 rgba(0,0,0,.45)" },
  "glow": { "$rule": "data only, never chrome", "marker": "0 0 8px domain@70%", "bandEdge": "0 0 5px domain@55%", "chosenTile": "0 0 18px accent@45%" },
  "motion": {
    "spring": { "response": 0.7, "damping": 0.8 },
    "tap": "160ms cubic-bezier(.2,.6,.3,1)",
    "dialSweep": "first appearance only",
    "haptics": { "select": "selection", "log": "success", "scrubDayChange": "selection" },
    "reducedMotion": "disable sweeps, tickers, glow animation"
  },
  "dial": { "arcStart": -135, "arcEnd": 135, "radius": 78, "box": 200, "track": 8, "trackMini": 6, "tickEvery": 15, "marker": 7, "markerMini": 5, "bandFill": 0.28, "bandEdge": 1.5 },
  "terrain": { "windowDays": 30, "hatch": { "size": 6, "angle": -20, "opacity": 0.22 }, "corridor": "surface3@80%", "line": 2, "currentDot": 4 },
  "figure": { "stroke": 11, "box": [380, 470], "sites": { "neck": 86, "chest": 150, "bicep": 178, "waist": 205, "hip": 262, "thigh": 345 } },
  "a11y": { "contrast": { "primary": "≥7:1", "secondary": "≥4.5:1" }, "touchTarget": 44, "focusRing": "2px accent, 2px offset", "colorAlone": "never" }
}
