{
  "$name": "bro / Baseline design tokens",
  "$rules": "See ../DESIGN.md. Domain colors mark data only; accent marks interaction only; alert is risk only, max once per screen.",
  "color": {
    "neutral": {
      "light": {
        "canvas": "#E9E9E4", "surface": "#F5F5F1", "surfaceSunk": "#E1E2DC",
        "line": "#D3D5CD", "lineStrong": "#B9BCB2",
        "ink": "#23282B", "ink2": "#5C6469", "ink3": "#8B9297", "inkInvert": "#F5F5F1"
      },
      "dark": {
        "canvas": "#191C1E", "surface": "#212528", "surfaceSunk": "#141719",
        "line": "#313739", "lineStrong": "#454C4F",
        "ink": "#E4E5E1", "ink2": "#A0A7AA", "ink3": "#767D81", "inkInvert": "#191C1E"
      }
    },
    "domain": {
      "$usage": "Identity of what is measured, never status. Data surfaces only.",
      "mind":  { "light": "#4E6473", "dark": "#86A3B5", "tintLight": "#DDE4E8", "tintDark": "#26333A", "covers": "mood, stress, check-ins" },
      "body":  { "light": "#667F5B", "dark": "#98AF8B", "tintLight": "#E0E6DC", "tintDark": "#2A332A", "covers": "heart, weight, movement" },
      "sleep": { "light": "#6F6A85", "dark": "#A29BBB", "tintLight": "#E2E0E8", "tintDark": "#2E2C39", "covers": "duration, timing, quality" },
      "load":  { "light": "#A0803F", "dark": "#C7A96C", "tintLight": "#EBE4D3", "tintDark": "#332E22", "covers": "training volume, strain" },
      "alert": { "light": "#93564A", "dark": "#C08375", "tintLight": "#EEDFDB", "tintDark": "#382723", "covers": "genuine health risk only" }
    },
    "accent": {
      "$usage": "User-owned. Interaction surfaces only. Stored as integer accentHue 0-360 on the user record; never a hex.",
      "model": "oklch",
      "input": { "hue": { "type": "integer", "min": 0, "max": 360, "default": 235 }, "chroma": { "default": 0.055, "graphite": 0.006 } },
      "derivation": {
        "light": {
          "accent":       "oklch(48% C H)",
          "accentStrong": "oklch(41% C H)",
          "accentTint":   "oklch(92% C*0.42 H)",
          "accentLine":   "oklch(78% C*0.70 H)",
          "onAccent":     "oklch(97% C*0.15 H)"
        },
        "dark": {
          "accent":       "oklch(78% C*1.15 H)",
          "accentStrong": "oklch(85% C*1.15 H)",
          "accentTint":   "oklch(30% C*0.75 H)",
          "accentLine":   "oklch(45% C*0.90 H)",
          "onAccent":     "oklch(18% C*0.30 H)"
        }
      },
      "presets": [
        { "name": "Harbour",  "hue": 235, "chroma": 0.055, "default": true },
        { "name": "Moss",     "hue": 145, "chroma": 0.055 },
        { "name": "Brass",    "hue": 85,  "chroma": 0.055 },
        { "name": "Clay",     "hue": 40,  "chroma": 0.055 },
        { "name": "Plum",     "hue": 318, "chroma": 0.055 },
        { "name": "Teal",     "hue": 195, "chroma": 0.055 },
        { "name": "Graphite", "hue": 250, "chroma": 0.006 }
      ]
    }
  },
  "type": {
    "family": {
      "sans":  { "value": "Archivo", "fallback": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif", "role": "all UI and all measured data" },
      "serif": { "value": "Source Serif 4", "fallback": "Georgia, serif", "role": "user-authored and reflective text only" }
    },
    "scale": {
      "metric":  { "px": 56, "weight": 600, "tracking": "-0.035em", "numerals": "tabular", "rule": "max one per screen" },
      "h1":      { "px": 40, "weight": 600, "tracking": "-0.02em" },
      "h2":      { "px": 27, "weight": 600, "tracking": "-0.015em" },
      "h3":      { "px": 21, "weight": 600 },
      "lead":    { "px": 17, "weight": 400, "family": "serif", "lineHeight": 1.6 },
      "body":    { "px": 15, "weight": 400, "lineHeight": 1.55 },
      "small":   { "px": 13, "weight": 400 },
      "caption": { "px": 12, "weight": 400, "rule": "never sole carrier of meaning" }
    },
    "case": "sentence case everywhere; no all-caps, no title-case buttons"
  },
  "space": { "unit": 4, "scale": [4, 8, 12, 16, 24, 32, 48, 64, 96] },
  "radius": { "sm": 3, "md": 6, "lg": 10, "pill": 999, "rule": "hierarchical: sm=chips/inputs, md=buttons/fields, lg=panels, pill=switch-like toggles only" },
  "elevation": { "levels": ["canvas", "surface"], "separator": "1px line", "shadows": "none", "scrim": "canvas at 55%" },
  "motion": { "duration": "160ms", "easing": "cubic-bezier(.2,.6,.3,1)", "trigger": "user action only; sole exception is gauge marker entry", "reducedMotion": "disable all" },
  "a11y": {
    "contrast": { "primaryText": "≥7:1", "secondaryText": "≥4.5:1" },
    "touchTarget": "44x44px minimum",
    "focusRing": "2px solid accent, 2px offset",
    "colorAlone": "never carries meaning; label + shape always present"
  }
}
