{
	"name": "@bro/app",
	"version": "0.0.1",
	"private": true,
	"main": "expo-router/entry",
	"scripts": {
		"eas-build-post-install": "cd ../../ && node tools/scripts/eas-build-post-install.mjs . apps/app"
	},
	"nx": {
		"tags": [
			"scope:app",
			"type:app"
		],
		"targets": {
			"test": {
				"executor": "nx:run-commands",
				"outputs": [
					"{projectRoot}/test-output/jest/coverage"
				],
				"options": {
					"cwd": "apps/app",
					"command": "jest --config jest.config.cjs"
				}
			}
		}
	},
	"dependencies": {
		"@better-auth/expo": "^1.6.27",
		"@bro/auth-app": "workspace:*",
		"@bro/database-app": "workspace:*",
		"@bro/domain": "workspace:*",
		"@expo/metro": "*",
		"@expo/vector-icons": "*",
		"@kingstinct/react-native-healthkit": "14.0.2",
		"@testing-library/react-native": "*",
		"better-auth": "^1.6.27",
		"expo": "*",
		"expo-build-properties": "~56.0.25",
		"expo-constants": "*",
		"expo-crypto": "~56.0.4",
		"expo-file-system": "~56.0.9",
		"expo-linking": "*",
		"expo-network": "*",
		"expo-notifications": "~56.0.23",
		"expo-router": "~56.2.18",
		"expo-secure-store": "*",
		"expo-splash-screen": "*",
		"expo-sqlite": "*",
		"expo-status-bar": "*",
		"expo-system-ui": "*",
		"expo-web-browser": "*",
		"jest-expo": "~56.0.5",
		"react": "19.2.3",
		"react-native": "*",
		"react-native-edge-to-edge": "^1.8.1",
		"react-native-gesture-handler": "~2.31.2",
		"react-native-health-connect": "4.1.3",
		"react-native-nitro-modules": "^0.36.5",
		"react-native-reanimated": "4.3.1",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "~4.26.2",
		"react-native-svg": "*",
		"react-native-svg-transformer": "*",
		"react-native-unistyles": "^3.3.0",
		"react-native-web": "*",
		"react-native-worklets": "0.8.3"
	},
	"devDependencies": {
		"@react-native/jest-preset": "0.85.3",
		"@types/jest": "~29.5.14",
		"jest": "~29.7.0"
	}
}
