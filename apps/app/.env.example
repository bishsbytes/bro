# Copy to apps/app/.env. Expo inlines EXPO_PUBLIC_* variables into the bundle.

# Where the Hono API is reachable from the device/simulator. On a physical
# device this must be your machine's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Reserved for future Turso embedded-replica sync. Leave both blank: the app
# currently supports local-only storage as its application workflow.
#
# SECURITY: a long-lived token here ships inside the app bundle and can be
# extracted. This is a dev convenience only; production should mint short-lived,
# device-scoped tokens from the API.
EXPO_PUBLIC_TURSO_SYNC_URL=
EXPO_PUBLIC_TURSO_AUTH_TOKEN=
