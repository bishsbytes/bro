# Copy to .env and adjust. Used by docker-compose and apps/api.

# Postgres (docker-compose)
POSTGRES_USER=bro
POSTGRES_PASSWORD=bro_dev_password
POSTGRES_DB=bro
POSTGRES_PORT=5432

# API
DATABASE_URL=postgresql://bro:bro_dev_password@localhost:5432/bro
PORT=3000

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Origin allowed to call the auth routes (Expo dev server by default).
CORS_ORIGIN=http://localhost:8081

# Set to "true" only when a proxy in front of this API overwrites
# X-Forwarded-For / CF-Connecting-IP. Otherwise food rate limiting counts the
# connection's own peer address, which a client cannot forge.
TRUST_PROXY_HEADERS=false

# Required by Open Food Facts so they can identify this API client.
OPEN_FOOD_FACTS_USER_AGENT=bro/0.1 (https://github.com/bishsbytes/bro)
