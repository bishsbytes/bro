{
	"name": "@bro/api",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"nx": {
		"tags": [
			"scope:api",
			"type:app"
		],
		"targets": {
			"test": {
				"executor": "nx:run-commands",
				"options": {
					"cwd": "apps/api",
					"command": "vitest run"
				}
			},
			"build": {
				"executor": "@nx/esbuild:esbuild",
				"outputs": [
					"{options.outputPath}"
				],
				"defaultConfiguration": "production",
				"options": {
					"platform": "node",
					"outputPath": "apps/api/dist",
					"format": [
						"esm"
					],
					"bundle": true,
					"main": "apps/api/src/main.ts",
					"tsConfig": "apps/api/tsconfig.app.json",
					"assets": [],
					"esbuildOptions": {
						"sourcemap": true,
						"outExtension": {
							".js": ".js"
						}
					}
				},
				"configurations": {
					"development": {
						"thirdParty": true
					},
					"production": {
						"esbuildOptions": {
							"sourcemap": false,
							"outExtension": {
								".js": ".js"
							}
						}
					}
				}
			},
			"prune-lockfile": {
				"dependsOn": [
					"build"
				],
				"cache": true,
				"executor": "@nx/js:prune-lockfile",
				"outputs": [
					"{workspaceRoot}/apps/api/dist/package.json",
					"{workspaceRoot}/apps/api/dist/pnpm-lock.yaml"
				],
				"options": {
					"buildTarget": "build"
				}
			},
			"copy-workspace-modules": {
				"dependsOn": [
					"build"
				],
				"cache": true,
				"outputs": [
					"{workspaceRoot}/apps/api/dist/workspace_modules"
				],
				"executor": "@nx/js:copy-workspace-modules",
				"options": {
					"buildTarget": "build"
				}
			},
			"prune": {
				"dependsOn": [
					"prune-lockfile",
					"copy-workspace-modules"
				],
				"executor": "nx:noop"
			},
			"serve": {
				"continuous": true,
				"executor": "@nx/js:node",
				"defaultConfiguration": "development",
				"options": {
					"buildTarget": "@bro/api:build",
					"inspect": false,
					"runBuildTargetDependencies": false,
					"watch": true,
					"runtimeArgs": [
						"--env-file=.env"
					]
				},
				"configurations": {
					"development": {
						"buildTarget": "@bro/api:build:development"
					},
					"production": {
						"buildTarget": "@bro/api:build:production",
						"watch": false
					}
				}
			}
		}
	},
	"dependencies": {
		"@bro/auth-api": "workspace:*",
		"@bro/database-api": "workspace:*",
		"@bro/domain": "workspace:*",
		"@hono/node-server": "^2.1.0",
		"better-auth": "^1.6.27",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.1",
		"postgres": "^3.4.9"
	},
	"devDependencies": {
		"@testcontainers/postgresql": "^12.1.0",
		"vitest": "^4.1.10"
	}
}
