{
	"name": "@bro/database-app",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./package.json": "./package.json"
	},
	"nx": {
		"tags": [
			"scope:app",
			"type:lib",
			"layer:data-access"
		],
		"targets": {
			"db:generate": {
				"executor": "nx:run-commands",
				"options": {
					"cwd": "packages/database/app",
					"commands": [
						"drizzle-kit generate",
						"tsx scripts/generate-migrations-manifest.ts"
					],
					"parallel": false
				}
			}
		}
	},
	"dependencies": {
		"@bro/domain": "workspace:*",
		"@bro/mobile-model": "workspace:*",
		"drizzle-orm": "^0.45.2"
	},
	"peerDependencies": {
		"expo-crypto": "~56.0.4",
		"expo-file-system": "~56.0.9",
		"expo-sqlite": "*"
	},
	"devDependencies": {
		"@react-native/jest-preset": "0.85.3",
		"@types/jest": "~29.5.14",
		"drizzle-kit": "^0.31.10",
		"expo-crypto": "~56.0.4",
		"expo-file-system": "~56.0.9",
		"expo-sqlite": "~56.0.5",
		"jest": "~29.7.0",
		"jest-expo": "~56.0.5",
		"tsx": "^4.23.12"
	}
}
