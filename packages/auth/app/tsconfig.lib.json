{
	"extends": "../../../tsconfig.base.json",
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "dist",
		"tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
		"emitDeclarationOnly": true,
		"forceConsistentCasingInFileNames": true,
		"jsx": "react-jsx",
		"lib": ["es2022", "dom"],
		"types": ["node", "react"],
		"module": "esnext",
		"moduleResolution": "bundler"
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"],
	"references": []
}
