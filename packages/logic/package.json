{
	"name": "@bro/logic",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./package.json": "./package.json"
	},
	"dependencies": {
		"@bro/database-app": "workspace:*",
		"@bro/domain": "workspace:*"
	},
	"devDependencies": {
		"vitest": "^4.1.10"
	},
	"nx": {
		"tags": [
			"scope:app",
			"type:lib"
		],
		"targets": {
			"test": {
				"executor": "nx:run-commands",
				"options": {
					"cwd": "packages/logic",
					"command": "vitest run"
				}
			}
		}
	}
}
