{
	"name": "@bro/source",
	"version": "0.0.0",
	"packageManager": "pnpm@10.34.5",
	"license": "MIT",
	"scripts": {
		"lint": "biome lint . && nx run-many -t lint",
		"lint:fix": "biome lint --write . && nx run-many -t lint",
		"lint:affected": "biome lint . && nx affected -t lint",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "biome check . && nx run-many -t lint",
		"android:build": "cd apps/app/android && ./gradlew assembleRelease",
		"android:install": "cd apps/app/android && ./gradlew installRelease",
		"brand": "node tools/scripts/brand-assets.mjs",
		"brand:check": "node tools/scripts/brand-assets.mjs --check"
	},
	"private": true,
	"enriched-markdown": {
		"enableCodeHighlight": false,
		"enableMath": false
	},
	"devDependencies": {
		"@babel/runtime": "catalog:",
		"@biomejs/biome": "catalog:",
		"@expo/cli": "catalog:",
		"@nx/esbuild": "catalog:",
		"@nx/eslint": "catalog:",
		"@nx/eslint-plugin": "catalog:",
		"@nx/expo": "catalog:",
		"@nx/jest": "catalog:",
		"@nx/js": "catalog:",
		"@nx/node": "catalog:",
		"@nx/vitest": "catalog:",
		"@swc/helpers": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"babel-preset-expo": "catalog:",
		"esbuild": "catalog:",
		"eslint": "catalog:",
		"eslint-plugin-i18next": "catalog:",
		"jest": "catalog:",
		"nx": "catalog:",
		"tslib": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"dependencies": {
		"@expo/metro": "catalog:",
		"@expo/metro-runtime": "catalog:",
		"expo": "catalog:",
		"expo-constants": "catalog:",
		"expo-linking": "catalog:",
		"expo-network": "catalog:",
		"expo-secure-store": "catalog:",
		"expo-splash-screen": "catalog:",
		"expo-sqlite": "catalog:",
		"expo-status-bar": "catalog:",
		"expo-system-ui": "catalog:",
		"expo-web-browser": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-native": "catalog:",
		"react-native-svg": "catalog:",
		"react-native-svg-transformer": "catalog:",
		"react-native-web": "catalog:"
	}
}
